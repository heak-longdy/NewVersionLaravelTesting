# ---------------------------------------------------------------------------
# Dual Claim Configuration & Hooks for Step 14.1 (Stage LA_AMLCLM)
# Supports Group 1 (CPO / SCM) and Group 2 (CAO / CDM) with dynamic parsing.
# ---------------------------------------------------------------------------

DUAL_CLAIM_GROUPS_SETTING = 'TONLE_LA_DUAL_CLAIM_GROUPS'
DUAL_CLAIM_DEFAULT_GROUPS = (('CPO', 'SCM'), ('CAO', 'CDM'))


def parseDualClaimRoles(Param=None):
    """
    Parses Group 1 (Processing/Lending) and Group 2 (Credit Assessment) roles.
    
    Supported formats on Activity Type / Transaction Param:
      1. Pipe delimited:  "CPO,SCM | CAO,CDM" or "CPO SCM | CAO CDM"
      2. Space delimited: "CPO,SCM CAO,CDM"
      3. Legacy 2-token:  "CPO CAO"
      4. AppSetting:      TONLE_LA_DUAL_CLAIM_GROUPS in MKT_APP_SETTING
      5. Fallback:        (('CPO', 'SCM'), ('CAO', 'CDM'))
    
    Returns:
      tuple: (tuple(Group1Roles), tuple(Group2Roles))
    """
    ParamStr = str(Param).strip() if Param else ''
    if not ParamStr:
        SettingVal = mktsetting.getAppSetting(DUAL_CLAIM_GROUPS_SETTING)
        ParamStr = str(SettingVal).strip() if SettingVal else ''

    if not ParamStr:
        return DUAL_CLAIM_DEFAULT_GROUPS

    if '|' in ParamStr:
        Parts = ParamStr.split('|', 1)
        G1 = tuple(r.strip() for r in Parts[0].replace(',', ' ').split() if r.strip())
        G2 = tuple(r.strip() for r in Parts[1].replace(',', ' ').split() if r.strip())
        return G1, G2

    Tokens = ParamStr.split()
    if len(Tokens) == 2 and ',' in ParamStr:
        G1 = tuple(r.strip() for r in Tokens[0].split(',') if r.strip())
        G2 = tuple(r.strip() for r in Tokens[1].split(',') if r.strip())
        return G1, G2

    if len(Tokens) == 2:
        # Legacy 2-token format ("CPO CAO")
        return (Tokens[0],), (Tokens[1],)

    return DUAL_CLAIM_DEFAULT_GROUPS


def getDualClaimAssignees(**kwargs):
    """
    Assignee resolver for the Dual Claim Stage (LA_AMLCLM):
    Returns all branch-eligible users across both Group 1 (CPO/SCM) and Group 2 (CAO/CDM).
    Flattens roles from both pools and delegates to getUsersRoleBranch.
    """
    G1Roles, G2Roles = parseDualClaimRoles(kwargs.get('Param'))
    AllRoles = list(dict.fromkeys(G1Roles + G2Roles))
    kwargs['Param'] = ' '.join(AllRoles)
    return getUsersRoleBranch(**kwargs)


def validateDualClaimBeforeAct(Data=None, Param=None, **outer_kwargs):
    """
    BeforeAct hook for A_CLAIMAML ('Assign case to me').
    Guarantees exactly 1 claim from Group 1 (CPO / SCM) and 1 claim from Group 2 (CAO / CDM).
    Blocks duplicate claims from the same group.
    Returns a callable to support Workflow V2's two-step BeforeAct execution.
    """
    def _execute(Data=None, Param=None, **kwargs):
        EffectiveParam = Param or kwargs.get('Param') or outer_kwargs.get('Param')
        RoleProcessingGroup, RoleAssessmentGroup = parseDualClaimRoles(EffectiveParam)

        CurrentUserID = session.get('getLogInID', '')
        UserObj = MKT_USER.query.filter_by(ID=CurrentUserID).first()
        if not UserObj:
            raise Exception(_l('User not found.'))
        UserRole = UserObj.Role

        WorkflowID = kwargs.get('WorkflowID') or outer_kwargs.get('WorkflowID')
        Workflow, LoanModel = _getWorkflowLoanSide(WorkflowID)
        if not Workflow or not Workflow.RecordID:
            return True
        LoanObj = LoanModel.query.get(Workflow.RecordID)
        if not LoanObj:
            return True

        InGroup1 = UserRole in RoleProcessingGroup
        InGroup2 = UserRole in RoleAssessmentGroup

        if not InGroup1 and not InGroup2:
            AllAllowed = ", ".join(RoleProcessingGroup + RoleAssessmentGroup)
            raise Exception(_l('Only users with eligible roles (%s) can claim this case.') % AllAllowed)

        # Evaluate Group 1 (Processing: CPO / SCM)
        if InGroup1:
            HasClaimedG1 = bool(LoanObj.AMLClaimedLOUser and LoanObj.AMLClaimedLOUser != "'")
            if HasClaimedG1 and not InGroup2:
                raise Exception(_l(
                    'This case has already been claimed by the Processing group (%s). '
                    'Awaiting claim from the Credit Assessment group (%s).'
                ) % (LoanObj.AMLClaimedLOUser, '/'.join(RoleAssessmentGroup)))
            if not HasClaimedG1:
                return True

        # Evaluate Group 2 (Credit Assessment: CAO / CDM)
        if InGroup2:
            HasClaimedG2 = bool(LoanObj.AMLClaimedCAOUser and LoanObj.AMLClaimedCAOUser != "'")
            if HasClaimedG2:
                raise Exception(_l(
                    'This case has already been claimed by the Credit Assessment group (%s). '
                    'Awaiting claim from the Processing group (%s).'
                ) % (LoanObj.AMLClaimedCAOUser, '/'.join(RoleProcessingGroup)))
            return True

        return True

    if 'WorkflowID' in outer_kwargs:
        return _execute(Data=Data, Param=Param, **outer_kwargs)
    return _execute


def claimAMLDualCase(Data=None, Param=None, **kwargs):
    """
    AfterAct hook for A_CLAIMAML ('Assign case to me').
    Persists the claimant's User ID into AMLClaimedLOUser or AMLClaimedCAOUser,
    removes all same-group peers (both officer and manager roles) from
    MKT_WORKFLOW_USER_ACTIVITY and updates NextAssignee so other users sharing
    the same group no longer see the record.
    """
    WorkflowID = kwargs.get('WorkflowID')
    if not WorkflowID:
        return
    Workflow, LoanModel = _getWorkflowLoanSide(WorkflowID)
    if Workflow is None or not Workflow.RecordID:
        return
    Obj = LoanModel.query.get(Workflow.RecordID)
    if Obj is None:
        return
    ClaimedBy = session.get('getLogInID', '')
    if not ClaimedBy:
        return
    UserObj = MKT_USER.query.filter_by(ID=ClaimedBy).first()
    if not UserObj:
        return

    RoleProcessingGroup, RoleAssessmentGroup = parseDualClaimRoles(Param or kwargs.get('Param'))

    try:
        SameGroupUsersToRemove = []

        # Claim Group 1 (CPO / SCM)
        if UserObj.Role in RoleProcessingGroup and (not Obj.AMLClaimedLOUser or Obj.AMLClaimedLOUser == "'"):
            Obj.AMLClaimedLOUser = ClaimedBy
            OtherGroupUsers = MKT_USER.query.filter(
                MKT_USER.Role.in_(RoleProcessingGroup),
                MKT_USER.ID != ClaimedBy
            ).all()
            SameGroupUsersToRemove = [u.ID for u in OtherGroupUsers]

        # Claim Group 2 (CAO / CDM)
        elif UserObj.Role in RoleAssessmentGroup and (not Obj.AMLClaimedCAOUser or Obj.AMLClaimedCAOUser == "'"):
            Obj.AMLClaimedCAOUser = ClaimedBy
            OtherGroupUsers = MKT_USER.query.filter(
                MKT_USER.Role.in_(RoleAssessmentGroup),
                MKT_USER.ID != ClaimedBy
            ).all()
            SameGroupUsersToRemove = [u.ID for u in OtherGroupUsers]

        db.session.add(Obj)

        # 1. Remove all same-group peers from active MKT_WORKFLOW_USER_ACTIVITY
        if SameGroupUsersToRemove:
            (db.session.query(MKT_WORKFLOW_USER_ACTIVITY)
             .filter(
                 MKT_WORKFLOW_USER_ACTIVITY.ID == WorkflowID,
                 MKT_WORKFLOW_USER_ACTIVITY.Stage == Workflow.Stage,
                 MKT_WORKFLOW_USER_ACTIVITY.UserID.in_(SameGroupUsersToRemove)
             )
             .delete(synchronize_session='fetch'))

        # 2. Update NextAssignee on Workflow main row
        if Workflow.NextAssignee:
            CurrentAssignees = Workflow.NextAssignee.split()
            FilteredAssignees = [u for u in CurrentAssignees if u not in SameGroupUsersToRemove]
            if ClaimedBy not in FilteredAssignees:
                FilteredAssignees.append(ClaimedBy)
            Workflow.NextAssignee = " ".join(FilteredAssignees)
            db.session.add(Workflow)

        db.session.commit()
    except Exception as Err:
        db.session.rollback()
        print('[Tonle claimAMLDualCase] commit failed for WorkflowID=%s: %s' % (WorkflowID, Err))


def getAMLClaimedLOUser(**kwargs):
    """
    Assignee resolver for Step 19 (Stage LA_AML):
    Routes exclusively to the Central Processing Officer / SCM who claimed the case (AMLClaimedLOUser).
    """
    Data = kwargs.get('Data', {})
    ID = Data.get('ID', '')
    Status = Data.get('Status', '')

    LoanAppObj = MKT_LOAN_APPLICATION_INAU.query.get(ID) if Status == 'INAU' else MKT_LOAN_APPLICATION.query.get(ID)
    ClaimedUser = LoanAppObj.AMLClaimedLOUser if LoanAppObj is not None else None
    if ClaimedUser and ClaimedUser != "'":
        return ClaimedUser

    return session.get('getLogInID', '') or ''


def getAMLClaimedCAOUser(**kwargs):
    """
    Assignee resolver for Step 21 (Stage LA_CREDIT - Credit Assessment Review):
    Routes exclusively to the Credit Assessment Officer / CDM who claimed the case (AMLClaimedCAOUser).
    """
    Data = kwargs.get('Data', {})
    ID = Data.get('ID', '')
    Status = Data.get('Status', '')

    LoanAppObj = MKT_LOAN_APPLICATION_INAU.query.get(ID) if Status == 'INAU' else MKT_LOAN_APPLICATION.query.get(ID)
    ClaimedUser = LoanAppObj.AMLClaimedCAOUser if LoanAppObj is not None else None
    if ClaimedUser and ClaimedUser != "'":
        return ClaimedUser

    return session.get('getLogInID', '') or ''
