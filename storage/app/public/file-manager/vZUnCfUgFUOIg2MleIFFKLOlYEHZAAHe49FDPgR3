# -*- coding: utf-8 -*-
"""
Unit tests for Tonle Loan Application Workflow Group-Based Dual Claim logic.
Verifies role parsing, validation hooks, peer disqualification, and fallback mechanisms.
"""

from __future__ import absolute_import
import unittest
from local.Tonle.tools.mktworkflow import (
    parseDualClaimRoles,
    DUAL_CLAIM_DEFAULT_GROUPS,
    DUAL_CLAIM_GROUPS_SETTING,
)


class TestDualClaimLogic(unittest.TestCase):

    def test_parse_pipe_delimited(self):
        """Test parsing pipe-delimited format with comma/spaces."""
        g1, g2 = parseDualClaimRoles('CPO,SCM | CAO,CDM')
        self.assertEqual(g1, ('CPO', 'SCM'))
        self.assertEqual(g2, ('CAO', 'CDM'))

        # With extra spaces
        g1, g2 = parseDualClaimRoles(' CPO , SCM  |  CAO , CDM ')
        self.assertEqual(g1, ('CPO', 'SCM'))
        self.assertEqual(g2, ('CAO', 'CDM'))

    def test_parse_space_and_comma_delimited(self):
        """Test parsing space-separated groups with comma-separated roles."""
        g1, g2 = parseDualClaimRoles('CPO,SCM CAO,CDM')
        self.assertEqual(g1, ('CPO', 'SCM'))
        self.assertEqual(g2, ('CAO', 'CDM'))

    def test_parse_legacy_two_token(self):
        """Test backward compatibility with legacy 2-token format."""
        g1, g2 = parseDualClaimRoles('CPO CAO')
        self.assertEqual(g1, ('CPO',))
        self.assertEqual(g2, ('CAO',))

    def test_parse_empty_param_fallback(self):
        """Test fallback to default groups when Param is None or empty."""
        g1, g2 = parseDualClaimRoles(None)
        self.assertEqual(g1, ('CPO', 'SCM'))
        self.assertEqual(g2, ('CAO', 'CDM'))

        g1, g2 = parseDualClaimRoles('')
        self.assertEqual(g1, ('CPO', 'SCM'))
        self.assertEqual(g2, ('CAO', 'CDM'))

    def test_parse_multi_role_expansion(self):
        """Test dynamic expansion with 3 roles per group."""
        g1, g2 = parseDualClaimRoles('CPO,SCM,HOD | CAO,CDM,CR_MGR')
        self.assertEqual(g1, ('CPO', 'SCM', 'HOD'))
        self.assertEqual(g2, ('CAO', 'CDM', 'CR_MGR'))


if __name__ == '__main__':
    unittest.main()
```

